<?xml version="1.0" encoding="utf-8"?>
<!-- ARDA_MEDIA_PHASE1H_CARMEDIA_REFERENCE_METADATA -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/metadata_loading_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/playback_loading"
        android:textColor="@color/arda_media_reference_primary_text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/album_art"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/arda_media_full_art_frame"
        android:clipToOutline="true"
        android:contentDescription="@string/album_art"
        android:scaleType="centerCrop"
        android:transitionName="@string/album_art"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/title"
        style="@style/MetadataPlaybackTitleStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/arda_media_reference_primary_text"
        app:layout_constraintBottom_toTopOf="@id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/album_art"
        app:layout_constraintTop_toTopOf="@id/album_art"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.android.car.apps.common.TappableTextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="10dp"
        app:hideViewMode="gone"
        app:layout_constraintBottom_toTopOf="@id/album_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/album_art"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:normalTextStyle="@style/MetadataPlaybackSubtitleStyle"
        app:tappableTextStyle="@style/MetadataPlaybackSubtitleClickableStyle" />

    <com.android.car.apps.common.TappableTextView
        android:id="@+id/album_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="6dp"
        app:hideViewMode="gone"
        app:layout_constraintBottom_toTopOf="@id/progress_text_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/album_art"
        app:layout_constraintTop_toBottomOf="@id/subtitle"
        app:normalTextStyle="@style/MetadataPlaybackSubtitleStyle"
        app:tappableTextStyle="@style/MetadataPlaybackSubtitleClickableStyle" />

    <include
        android:id="@+id/progress_text_container"
        layout="@layout/time_progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="@id/album_art"
        app:layout_constraintStart_toEndOf="@id/album_art"
        app:layout_constraintTop_toBottomOf="@id/album_title" />

    <com.android.car.apps.common.TappableTextView
        android:id="@+id/artist"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:hideViewMode="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>
