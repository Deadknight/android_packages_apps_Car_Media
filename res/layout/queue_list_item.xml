<?xml version="1.0" encoding="utf-8"?>
<!-- ARDA_MEDIA_PHASE1H_CARMEDIA_REFERENCE_QUEUE_ITEM -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_container"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <FrameLayout
        android:id="@+id/thumbnail_container"
        android:layout_width="64dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/thumbnail"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/arda_media_full_art_frame"
            android:clipToOutline="true"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <Space
        android:id="@+id/spacer"
        android:layout_width="16dp"
        android:layout_height="1dp"
        app:layout_constraintStart_toEndOf="@id/thumbnail_container"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/queue_list_item_titles_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/thumbnail_container"
        app:layout_constraintEnd_toStartOf="@id/now_playing_icon"
        app:layout_constraintStart_toEndOf="@id/spacer"
        app:layout_constraintTop_toTopOf="@id/thumbnail_container"
        app:layout_constraintVertical_bias="0.5">

        <TextView
            android:id="@+id/queue_list_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/arda_media_reference_primary_text"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="start|center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/queue_list_item_icons"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/queue_list_item_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/arda_media_reference_secondary_text"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/current_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/slash_separator"
        android:visibility="gone" />

    <TextView
        android:id="@+id/max_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/now_playing_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="10dp"
        android:src="@drawable/ic_equalizer"
        android:tint="@color/arda_media_reference_progress"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
